# Copiar a .env. No contiene credenciales.
COMPOSE_PROJECT_NAME=backoffice
FRONTEND_PORT=3000
BACKEND_PORT=3001
MYSQL_DATABASE=crm
MYSQL_USER=crm_app
# Definir contraseñas locales antes de arrancar; no versionar valores reales.
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
MYSQL_PORT=3307
ADMINER_PORT=8082

# El alta y el trigger guardan avisos aunque los envíos estén desactivados.
NOTIFICATIONS_ENABLED=false
NOTIFICATIONS_INTERNAL_TO=avisos@example.invalid
MAIL_FROM=remitente@example.invalid
MAIL_TRANSPORT=microsoft365
NOTIFICATIONS_CONSULTATION_URL=http://localhost:3000
NOTIFICATIONS_INTERVAL_MS=5000
NOTIFICATIONS_MAX_ATTEMPTS=5
# Aplicación de Entra autorizada para Mail.Send en el buzón; ver docs/notificaciones-correo.md.
MS365_TENANT_ID=
MS365_CLIENT_ID=
MS365_CLIENT_SECRET=
# Alternativa SMTP y pruebas locales; no se utiliza con microsoft365.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_USER=
SMTP_PASSWORD=
