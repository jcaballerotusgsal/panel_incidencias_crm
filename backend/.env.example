# Solo PM2: copiar a backend/.env y completar en el servidor. No usar el .env de Docker.
# Los puertos HTTP y NODE_ENV se configuran en ecosystem.config.js.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=crm_pruebas
DB_USER=crm_app
DB_PASSWORD=

# Activar únicamente después de configurar el proveedor y revisar los avisos pendientes.
NOTIFICATIONS_ENABLED=false
NOTIFICATIONS_INTERNAL_TO=
MAIL_FROM=
MAIL_TRANSPORT=microsoft365
NOTIFICATIONS_CONSULTATION_URL=
MS365_TENANT_ID=
MS365_CLIENT_ID=
MS365_CLIENT_SECRET=
NOTIFICATIONS_INTERVAL_MS=5000
NOTIFICATIONS_MAX_ATTEMPTS=5

# Solo si se elige MAIL_TRANSPORT=smtp.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_USER=
SMTP_PASSWORD=
