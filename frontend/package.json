{
  "name": "backoffice-web",
  "version": "0.1.0",
  "private": true,
  "description": "Interfaz del backoffice con Next.js, React y Tailwind CSS",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "next dev --webpack --hostname 0.0.0.0 --port 3000",
    "build": "next build --webpack",
    "start": "next start --hostname 0.0.0.0 --port 3000",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint .",
    "test:smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "next": "^16.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.0",
    "tailwindcss": "^4.1.0",
    "postcss": "^8.5.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "typescript": "~5.9.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.0.0"
  }
}
